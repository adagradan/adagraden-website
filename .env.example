# Public site address — used for canonical URLs, Open Graph, sitemap and
# structured data. Set this to the real domain before launch.
NEXT_PUBLIC_SITE_URL=https://example.org

# Contact form delivery (optional). Any endpoint that accepts a JSON POST:
# Formspree, Make, Zapier, Google Apps Script, or your own API. Until this is
# set, the contact form validates but tells visitors their message was NOT sent.
CONTACT_WEBHOOK_URL=
