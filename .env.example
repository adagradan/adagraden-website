# Public site address — canonical URLs, sitemap, email images, Flutterwave
# redirect. Set this to the real domain before launch.
NEXT_PUBLIC_SITE_URL=https://example.org

# ---- Email (Resend) — contact form, transfer details, receipts ----
# MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM="Ada Gradan Foundation <hello@example.org>"
# Receives contact messages and a copy of every pledge and receipt.
NOTIFY_EMAIL=

# ---- Admin dashboard (/admin) — donations & acknowledgements ----
# MongoDB stores every pledge. Giving still works without it (emails only),
# but the dashboard needs it. A free MongoDB Atlas cluster is enough.
MONGODB_URI=
MONGODB_DB=adagradan
# Who may sign in (comma-separated). Sign-in is by one-time email link.
ADMIN_EMAILS=
# At least 32 random characters, e.g.:  openssl rand -base64 48
ADMIN_SESSION_SECRET=

# ---- Card payments (Flutterwave) — OFF until CARD_PAYMENTS=on ----
# Bank transfer always works. Use TEST keys first. Register the webhook
# https://YOUR-DOMAIN/api/webhooks/flutterwave with the same secret hash.
CARD_PAYMENTS=off
FLW_SECRET_KEY=
FLW_SECRET_HASH=

# Optional fallback for the contact form if Resend is not configured.
CONTACT_WEBHOOK_URL=
